---
import type { ReleaseInfo } from '../lib/github';
import { formatSize } from '../lib/github';
import { statusLabel } from '../lib/labels';

interface Props {
  name: string;
  status: keyof typeof statusLabel;
  kind: 'apk' | 'firmware' | 'none';
  repo?: string;
  minAndroid?: string;
  release: ReleaseInfo | null;
}
const { name, status, kind, repo, minAndroid, release } = Astro.props;
const repoUrl = repo ? `https://github.com/${repo}` : undefined;
const fileWord = kind === 'firmware' ? 'firmware' : 'APK';
const date = release?.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'America/Denver' });
---

<aside class="dl" aria-labelledby="dl-title">
  {
    release?.primary ? (
      <>
        <h2 id="dl-title" class="dl__title">
          Version {release.version.replace(/^v/i, '')}
        </h2>
        <p class="dl__meta">
          Released {date}. {formatSize(release.primary.size)}.
          {minAndroid && <> Needs Android {minAndroid} or newer.</>}
        </p>
        <a class="button dl__button" href={release.primary.url} download>
          Download {fileWord}
        </a>
        {release.primary.sha256 && (
          <details class="dl__hash">
            <summary>SHA-256 checksum</summary>
            <code>{release.primary.sha256}</code>
          </details>
        )}
        <a class="dl__more" href={release.pageUrl.replace(/\/tag\/.*/, '')}>
          Older versions and all files
        </a>
      </>
    ) : (
      <>
        <h2 id="dl-title" class="dl__title">
          {status === 'planned' ? 'Not available yet' : 'No public release yet'}
        </h2>
        <p class="dl__meta">
          {status === 'planned'
            ? `${name} is still being planned.`
            : `${name} is ${status === 'beta' ? 'in beta' : 'in development'}. The download will appear here when the first version is out.`}
        </p>
        {repoUrl && (
          <a class="button button--quiet dl__button" href={repoUrl}>
            Follow on GitHub
          </a>
        )}
      </>
    )
  }
</aside>

<style>
  .dl {
    position: relative;
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    background:
      linear-gradient(160deg, rgb(255 255 255 / 0.09), rgb(255 255 255 / 0.03)),
      color-mix(in oklab, var(--stone) 14%, var(--smoky));
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.14),
      0 24px 60px -30px color-mix(in oklab, var(--stone) 60%, transparent);
    backdrop-filter: blur(18px);
  }
  .dl__title { font-size: var(--step-2); font-weight: 400; }
  .dl__meta { margin-top: 0.5rem; color: var(--muted); font-size: var(--step--1); }
  .dl__button { margin-top: 1.4rem; width: 100%; justify-content: center; }
  .dl__hash { margin-top: 1rem; font-size: var(--step--1); color: var(--muted); }
  .dl__hash summary { cursor: pointer; }
  .dl__hash code {
    display: block;
    margin-top: 0.5rem;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-sm);
    background: rgb(0 0 0 / 0.25);
    font-size: 0.78rem;
    word-break: break-all;
    color: var(--text);
  }
  .dl__more {
    display: inline-block;
    margin-top: 1rem;
    font-size: var(--step--1);
    color: var(--muted);
  }
</style>
