---
// A guided tour of an app. The device settles onto the table when the tour
// scrolls into view (after the intro video, if there is one), the sheet slides
// in, and the gems switch between screenshots.
//
// The scene is a 3:2 picture. Everything on it is placed in percent of that
// picture, measured from the 1131×754 mockups:
//   device.webp   the device cut out of its mockup
//   shadow.webp   its shadow on the table
//   screen        the display inside the device, where the screenshots go
// scene.jpg is the intro video's last frame, so the still and the video line up.
//
// Kinds:
//   eink   480×800 screenshots multiplied onto the reader's grey panel, with an
//          e-ink style flash between pages.
//   phone  full-page web screenshots under the phone's frame (its screen is
//          transparent), scrolling slowly; pages cross-fade.
interface Slide {
  title: string;
  text: string;
  image: string;
  alt: string;
}
interface Props {
  id: string;
  dir: string;
  slides: Slide[];
  label: string;
  kind?: 'eink' | 'phone';
  intro?: boolean;
  title?: string;
}
const { id, dir, slides, label, kind = 'eink', intro = false, title } = Astro.props;
const base = dir.replace(/\/$/, '');
const phone = kind === 'phone';
// [left, top, width, height] in percent: the device and its shadow in the scene,
// the screen in the device.
const GEOMETRY = {
  eink: {
    device: [56.587, 16.976, 32.891, 79.841],
    shadow: [58.709, 94.164, 29.266, 2.122],
    screen: [10.753, 6.811, 73.656, 76.08],
    focus: 73.03,
  },
  phone: {
    device: [59.24, 8.753, 28.647, 86.737],
    shadow: [58.798, 20.822, 35.013, 75.199],
    screen: [7.099, 3.67, 83.642, 92.202],
    focus: 73.52,
  },
}[kind];
const box = (r: number[], prefix: string) =>
  `--${prefix}-l:${r[0]}%;--${prefix}-t:${r[1]}%;--${prefix}-w:${r[2]}%;--${prefix}-h:${r[3]}%;`;
const geometry =
  box(GEOMETRY.device, 'dev') + box(GEOMETRY.shadow, 'sh') + box(GEOMETRY.screen, 'scr') + `--focus:${GEOMETRY.focus}%;`;
---

<section class:list={['tour', `tour--${kind}`]} aria-roledescription="carousel" aria-label={label}>
  {title && <h2 class="tour__title">{title}</h2>}
  <div class="tour__stage" data-state="ready" data-intro={intro ? 'video' : 'none'} style={geometry}>
    <div class="tour__view">
      <div class="tour__scene">
        <img class="tour__still" src={`${base}/scene.jpg`} alt="" width="1131" height="754" decoding="async" />
        {
          intro && (
            <video
              class="tour__video"
              src={`${base}/intro.mp4`}
              poster={`${base}/intro-poster.jpg`}
              muted
              playsinline
              preload="metadata"
              aria-hidden="true"
              tabindex="-1"
            />
          )
        }
        <img class="tour__shadow" src={`${base}/shadow.webp`} alt="" decoding="async" />
        <div class="tour__device">
          <img class="tour__body" src={`${base}/device.webp`} alt="" decoding="async" />
          <div class="tour__screen">
            {
              slides.map((s, i) =>
                phone ? (
                  <div class:list={['tour__shot', 'tour__page', { 'is-active': i === 0 }]} aria-hidden={i === 0 ? undefined : 'true'}>
                    <img
                      src={`${base}/${s.image}`}
                      alt={i === 0 ? s.alt : ''}
                      data-alt={s.alt}
                      width="540"
                      loading={i === 0 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                  </div>
                ) : (
                  <img
                    class:list={['tour__shot', { 'is-active': i === 0 }]}
                    src={`${base}/${s.image}`}
                    alt={i === 0 ? s.alt : ''}
                    aria-hidden={i === 0 ? undefined : 'true'}
                    data-alt={s.alt}
                    width="480"
                    height="800"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                ),
              )
            }
            {!phone && <span class="tour__flash" aria-hidden="true" />}
          </div>
        </div>
      </div>
      {intro && <button type="button" class="tour__skip">Skip intro</button>}
    </div>

    <div class="tour__gems" role="tablist" aria-label={label}>
      {
        slides.map((s, i) => (
          <button
            type="button"
            role="tab"
            class="tour__gem"
            id={`${id}-tab-${i}`}
            aria-controls={`${id}-panel-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            title={s.title}>
            <svg viewBox="0 0 48 48" aria-hidden="true">
              <polygon class="gem__outer" points="45,24 34.5,42.2 13.5,42.2 3,24 13.5,5.8 34.5,5.8" />
              <polygon class="gem__table" points="35,24 29.5,33.5 18.5,33.5 13,24 18.5,14.5 29.5,14.5" />
              <path
                class="gem__facets"
                d="M35 24L45 24M29.5 33.5L34.5 42.2M18.5 33.5L13.5 42.2M13 24L3 24M18.5 14.5L13.5 5.8M29.5 14.5L34.5 5.8"
              />
            </svg>
            <span class="tour__num">{i + 1}</span>
            <span class="visually-hidden">{s.title}</span>
          </button>
        ))
      }
    </div>

    <div class="tour__sheet">
      {
        slides.map((s, i) => (
          <article
            class="tour__panel"
            role="tabpanel"
            id={`${id}-panel-${i}`}
            aria-labelledby={`${id}-tab-${i}`}
            hidden={i !== 0}>
            <h3>{s.title}</h3>
            {s.text
              .trim()
              .split(/\n\s*\n/)
              .map((p) => (
                <p>{p.replace(/\s*\n\s*/g, ' ')}</p>
              ))}
          </article>
        ))
      }
    </div>
  </div>
</section>

<script is:inline>
  // Before first paint: hide the device and sheet so the intro can bring them
  // in. Without JavaScript, or with reduced motion, the tour starts finished.
  (() => {
    const stage = document.currentScript.previousElementSibling.querySelector('.tour__stage');
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) stage.dataset.state = 'idle';
  })();
</script>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const stage of document.querySelectorAll<HTMLElement>('.tour__stage')) {
    const video = stage.querySelector<HTMLVideoElement>('.tour__video');
    const tabs = [...stage.querySelectorAll<HTMLButtonElement>('.tour__gem')];
    const panels = [...stage.querySelectorAll<HTMLElement>('.tour__panel')];
    const shots = [...stage.querySelectorAll<HTMLElement>('.tour__shot')];
    const flash = stage.querySelector<HTMLElement>('.tour__flash');
    const pages = shots.every((shot) => shot.classList.contains('tour__page'));
    const view = stage.querySelector<HTMLElement>('.tour__view')!;
    let current = 0;
    let swapTimer = 0;

    // Phone pages scroll slowly down, rest, and return to the top, while the
    // tour is on screen. Touching or scrolling a page pauses it for a while.
    const scroller = (() => {
      const SPEED = 38; // CSS px per second
      let phase: 'top' | 'down' | 'bottom' = 'top';
      let phaseAt = 0;
      let last = 0;
      let pos = 0;
      let pausedUntil = 0;
      let frame = 0;
      let visible = false;
      const page = () => shots[current];
      const tick = (now: number) => {
        frame = 0;
        const el = page();
        const max = el.scrollHeight - el.clientHeight;
        if (now < pausedUntil) {
          pos = el.scrollTop;
          last = now;
        } else if (max > 4) {
          if (phase === 'top' && now - phaseAt > 1800) {
            phase = 'down';
            last = now;
            pos = el.scrollTop;
          } else if (phase === 'down') {
            pos = Math.min(max, pos + (SPEED * (now - last)) / 1000);
            last = now;
            el.scrollTop = pos;
            if (pos >= max) {
              phase = 'bottom';
              phaseAt = now;
            }
          } else if (phase === 'bottom' && now - phaseAt > 2600) {
            el.scrollTo({ top: 0, behavior: 'smooth' });
            phase = 'top';
            phaseAt = now + 900;
            pos = 0;
          }
        }
        if (visible) frame = requestAnimationFrame(tick);
      };
      const run = () => {
        if (!frame && visible && !reduceMotion && stage.dataset.state === 'ready') frame = requestAnimationFrame(tick);
      };
      for (const shot of shots) {
        const pause = () => (pausedUntil = performance.now() + 6000);
        shot.addEventListener('wheel', pause, { passive: true });
        shot.addEventListener('touchstart', pause, { passive: true });
        shot.addEventListener('pointerdown', pause);
      }
      if (pages) {
        new IntersectionObserver((entries) => {
          visible = entries.some((entry) => entry.isIntersecting);
          run();
        }).observe(stage);
      }
      return {
        restart() {
          const el = page();
          el.scrollTop = 0;
          pos = 0;
          phase = 'top';
          phaseAt = performance.now();
          pausedUntil = 0;
          run();
        },
      };
    })();

    // Gems and text can't be reached until the device is on the table.
    const setInert = (inert: boolean) => {
      for (const el of stage.querySelectorAll<HTMLElement>('.tour__gems, .tour__sheet')) el.inert = inert;
    };

    function finishIntro(skipped: boolean) {
      if (stage.dataset.state === 'ready') return;
      if (skipped && video) {
        video.pause();
        stage.classList.add('is-skipped');
      }
      stage.dataset.state = 'ready';
      setInert(false);
      if (pages) scroller.restart();
    }

    function startIntro() {
      if (stage.dataset.state !== 'idle') return;
      // Without a video, the device just settles onto the table.
      if (!video) {
        finishIntro(false);
        return;
      }
      stage.dataset.state = 'intro';
      // Autoplay can be refused (battery saver, data saver); then skip straight to the end.
      const fallback = window.setTimeout(() => finishIntro(true), 3000);
      video.addEventListener('playing', () => window.clearTimeout(fallback), { once: true });
      video.play().catch(() => {
        window.clearTimeout(fallback);
        finishIntro(true);
      });
    }

    function show(index: number, focus = false) {
      const next = (index + tabs.length) % tabs.length;
      if (next === current) return;
      tabs.forEach((tab, i) => {
        tab.setAttribute('aria-selected', String(i === next));
        tab.tabIndex = i === next ? 0 : -1;
      });
      panels.forEach((panel, i) => (panel.hidden = i !== next));
      if (focus) tabs[next].focus();

      const swap = () => {
        shots.forEach((shot, i) => {
          const on = i === next;
          shot.classList.toggle('is-active', on);
          const img = shot instanceof HTMLImageElement ? shot : shot.querySelector('img')!;
          img.alt = on ? img.dataset.alt || '' : '';
          if (on) shot.removeAttribute('aria-hidden');
          else shot.setAttribute('aria-hidden', 'true');
        });
        if (pages) scroller.restart();
      };
      current = next;
      window.clearTimeout(swapTimer);
      // Phone pages cross-fade (CSS); reduced motion swaps at once.
      if (reduceMotion || !flash) {
        swap();
        return;
      }
      // An e-ink style refresh: the panel flashes dark, then shows the new page.
      flash.classList.remove('is-flashing');
      void flash.offsetWidth;
      flash.classList.add('is-flashing');
      swapTimer = window.setTimeout(swap, 170);
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => show(i));
      tab.addEventListener('keydown', (event) => {
        const keys: Record<string, number> = {
          ArrowRight: current + 1,
          ArrowDown: current + 1,
          ArrowLeft: current - 1,
          ArrowUp: current - 1,
          Home: 0,
          End: tabs.length - 1,
        };
        if (event.key in keys) {
          event.preventDefault();
          show(keys[event.key], true);
        }
      });
    });

    // Swipe the picture to change pages.
    let startX = 0;
    let startY = 0;
    view.addEventListener('pointerdown', (event) => {
      startX = event.clientX;
      startY = event.clientY;
    });
    view.addEventListener('pointerup', (event) => {
      const dx = event.clientX - startX;
      const dy = event.clientY - startY;
      if (stage.dataset.state === 'ready' && Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.5) {
        show(current + (dx < 0 ? 1 : -1));
      }
    });

    stage.querySelector('.tour__skip')?.addEventListener('click', () => finishIntro(true));
    video?.addEventListener('ended', () => finishIntro(false));
    video?.addEventListener('error', () => finishIntro(true));

    if (stage.dataset.state === 'idle') {
      setInert(true);
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            observer.disconnect();
            startIntro();
          }
        },
        { threshold: 0.45 },
      );
      observer.observe(view);
    }
  }
</script>

<style>
  .tour {
    --accent: #a9a8ee;
    --sheet: rgb(16 13 30 / 0.78);
    max-width: 76rem;
    margin: clamp(1rem, 3vw, 2rem) auto 0;
    padding-inline: var(--gutter);
  }
  .tour__stage {
    position: relative;
    container-type: inline-size;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #0b0a10;
  }

  /* The scene: a 3:2 picture with every layer placed in percent of it. */
  .tour__view {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    touch-action: pan-y;
  }
  .tour__scene {
    position: absolute;
    inset: 0;
  }
  .tour__still,
  .tour__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .tour__video { transition: opacity 0.4s; }
  .tour__stage[data-state='ready'] .tour__video { pointer-events: none; }
  .tour__stage.is-skipped .tour__video { opacity: 0; }

  .tour__shadow {
    position: absolute;
    left: var(--sh-l);
    top: var(--sh-t);
    width: var(--sh-w);
    height: var(--sh-h);
  }
  .tour__device {
    position: absolute;
    left: var(--dev-l);
    top: var(--dev-t);
    width: var(--dev-w);
    height: var(--dev-h);
  }
  .tour__body {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .tour__screen {
    position: absolute;
    left: var(--scr-l);
    top: var(--scr-t);
    width: var(--scr-w);
    height: var(--scr-h);
    border-radius: 2.4% / 1.4%;
    overflow: hidden;
  }
  /* Phone: the pages sit under the frame, whose screen is transparent. */
  /* The screen's own corner radius (30 px on the 271 × 603 px mockup screen),
     so its white backing never shows past the frame's rounded corners. */
  .tour--phone .tour__screen {
    border-radius: 11% / 5%;
    background: #fff;
  }
  /* The lit screen arrives with the frame; its page fades in after. */
  .tour--phone .tour__device::before {
    content: '';
    position: absolute;
    left: var(--scr-l);
    top: var(--scr-t);
    width: var(--scr-w);
    height: var(--scr-h);
    border-radius: 11% / 5%;
    background: #fff;
  }
  .tour--phone .tour__body {
    z-index: 1;
    pointer-events: none;
  }
  .tour__page {
    position: absolute;
    inset: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.35s ease,
      visibility 0s linear 0.35s;
  }
  .tour__page::-webkit-scrollbar { display: none; }
  .tour__page.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.35s ease;
  }
  .tour__page img {
    display: block;
    width: 100%;
    height: auto;
  }
  .tour__title {
    margin: 0 0 1rem;
    font-size: var(--step-3);
  }
  /* Multiplied onto the panel, white paper takes the screen's own warm grey. */
  img.tour__shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    mix-blend-mode: multiply;
    opacity: 0;
  }
  img.tour__shot.is-active { opacity: 0.9; }
  .tour__flash {
    position: absolute;
    inset: 0;
    background: #1a1714;
    opacity: 0;
    pointer-events: none;
  }
  .tour__flash.is-flashing { animation: tour-flash 0.42s ease-out; }
  @keyframes tour-flash {
    0% { opacity: 0; }
    35% { opacity: 0.85; }
    100% { opacity: 0; }
  }

  /* The sheet and the gems sit over the scene's open left side. */
  .tour__sheet {
    position: absolute;
    left: 9.1%;
    top: 19.4%;
    width: 42.2%;
    height: 75%;
    padding: 2.2cqw 2.3cqw;
    border-radius: 2cqw;
    background: var(--sheet);
    box-shadow:
      inset 0 0 0 1.5px color-mix(in srgb, var(--accent) 70%, transparent),
      0 1.5cqw 4cqw rgb(0 0 0 / 0.45);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: #f1eff8;
    overflow: hidden;
  }
  /* All panels share one cell, so the sheet keeps the height of the longest. */
  .tour__sheet { display: grid; align-content: start; }
  .tour__panel { grid-area: 1 / 1; }
  .tour__panel[hidden] {
    display: block;
    visibility: hidden;
  }
  .tour__panel h3 {
    margin: 0 0 1.3cqw;
    padding-bottom: 1.1cqw;
    border-bottom: 1px solid rgb(241 239 248 / 0.55);
    font-size: 2.45cqw;
    font-weight: 640;
    line-height: 1.15;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }
  .tour__panel p {
    margin: 0 0 1.25cqw;
    font-size: 1.5cqw;
    line-height: 1.5;
    color: rgb(241 239 248 / 0.92);
  }
  .tour__panel:not([hidden]) { animation: tour-panel 0.45s ease-out; }
  @keyframes tour-panel {
    from { opacity: 0; transform: translateY(0.6cqw); }
  }

  .tour__gems {
    position: absolute;
    left: 50%;
    top: 4.5%;
    transform: translateX(-50%);
    display: flex;
    gap: 2.4cqw;
  }
  .tour__gem {
    position: relative;
    display: grid;
    place-items: center;
    width: 4.4cqw;
    height: 4.4cqw;
    min-width: 34px;
    min-height: 34px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    color: #f1eff8;
    font: inherit;
  }
  .tour__gem svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    transition: transform 0.2s, filter 0.2s;
  }
  .gem__outer {
    fill: rgb(16 13 30 / 0.7);
    stroke: var(--accent);
    stroke-width: 1.6;
    stroke-linejoin: round;
  }
  .gem__table {
    fill: rgb(169 168 238 / 0.08);
    stroke: color-mix(in srgb, var(--accent) 55%, transparent);
    stroke-width: 1;
    stroke-linejoin: round;
  }
  .gem__facets {
    stroke: color-mix(in srgb, var(--accent) 55%, transparent);
    stroke-width: 1;
  }
  .tour__num {
    position: relative;
    font-size: max(0.8rem, 1.35cqw);
    font-weight: 560;
    line-height: 1;
  }
  .tour__gem:hover svg { transform: scale(1.08); }
  .tour__gem[aria-selected='true'] svg {
    transform: scale(1.12);
    filter: drop-shadow(0 0 0.7cqw rgb(169 168 238 / 0.75));
  }
  .tour__gem[aria-selected='true'] .gem__outer { fill: var(--accent); stroke: #e9e8ff; }
  .tour__gem[aria-selected='true'] .gem__table { fill: #c4c3f6; stroke: rgb(255 255 255 / 0.6); }
  .tour__gem[aria-selected='true'] .gem__facets { stroke: rgb(255 255 255 / 0.55); }
  .tour__gem[aria-selected='true'] .tour__num { color: #15122a; }
  .tour__gem:focus-visible { outline: 2px solid #fff; outline-offset: 4px; border-radius: 6px; }

  .tour__skip {
    position: absolute;
    right: 1.4cqw;
    bottom: 1.4cqw;
    padding: 0.35rem 0.9rem;
    border: 0;
    border-radius: 999px;
    background: rgb(16 13 30 / 0.6);
    color: #f1eff8;
    font: inherit;
    font-size: var(--step--1);
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
  }
  .tour__stage[data-state='intro'] .tour__skip { opacity: 1; pointer-events: auto; }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Arrival: the device settles onto the table, the screen wakes, then the sheet and gems. */
  .tour__device,
  .tour__shadow,
  .tour__screen,
  .tour__sheet,
  .tour__gems {
    transition:
      opacity 0.7s ease,
      transform 0.8s cubic-bezier(0.2, 0.75, 0.2, 1);
  }
  .tour__stage:is([data-state='idle'], [data-state='intro']) .tour__device {
    opacity: 0;
    transform: translateY(-5%);
  }
  .tour__stage:is([data-state='idle'], [data-state='intro']) :is(.tour__shadow, .tour__screen) { opacity: 0; }
  .tour__stage:is([data-state='idle'], [data-state='intro']) .tour__sheet {
    opacity: 0;
    transform: translateX(-4%);
  }
  .tour__stage:is([data-state='idle'], [data-state='intro']) .tour__gems {
    opacity: 0;
    transform: translate(-50%, -30%);
  }
  .tour__stage[data-state='ready'] .tour__shadow { transition-delay: 0.25s; }
  .tour__stage[data-state='ready'] .tour__screen {
    transition-delay: 0.85s;
    transition-duration: 0.25s;
  }
  .tour__stage[data-state='ready'] .tour__sheet { transition-delay: 1.1s; }
  .tour__stage[data-state='ready'] .tour__gems { transition-delay: 1.35s; }

  /* Narrow screens: crop the scene around the reader, gems and text below it. */
  @media (max-width: 52rem) {
    .tour { padding-inline: 0; }
    .tour__title { padding-inline: var(--gutter); }
    .tour__stage {
      border-radius: 0;
      background: none;
      overflow: visible;
    }
    .tour__view {
      aspect-ratio: 4 / 5;
      max-height: 78vh;
      margin-inline: auto;
      border-radius: 0;
    }
    .tour__scene {
      inset: 0 auto 0 50%;
      height: 100%;
      aspect-ratio: 3 / 2;
      transform: translateX(calc(-1 * var(--focus)));
    }
    .tour__gems {
      position: relative;
      left: auto;
      top: auto;
      justify-content: center;
      flex-wrap: wrap;
      gap: 0.55rem;
      margin: 1.1rem auto 0;
      padding-inline: var(--gutter);
      transform: none;
    }
    .tour__stage:is([data-state='idle'], [data-state='intro']) .tour__gems { transform: translateY(-20%); }
