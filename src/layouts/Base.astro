---
import '../styles/global.css';
import { site } from '../site';

interface Props {
  title?: string;
  description?: string;
  stone?: string;
}
const { title, description = site.description, stone } = Astro.props;
const fullTitle = title ? `${title} | ${site.title}` : `${site.title}: private apps for Android`;
const isHome = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#1e1a2e" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body data-stone={stone}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top wrap">
      <a class="brand" href="/" aria-current={isHome ? 'page' : undefined}>
        <img src="/favicon.svg" alt="" width="22" height="22" />
        Quartz
      </a>
      <nav aria-label="Main">
        <a href="/#apps">Apps</a>
        <a href="/#privacy">Privacy</a>
        <a href="/extras/">Extras</a>
        {site.kofi && <a href={site.kofi}>Support</a>}
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap foot__inner">
        <p>
          Made by <a href={site.authorUrl}>{site.author}</a>. No ads and no tracking in any Quartz app.
        </p>
        <ul>
          <li><a href={site.github}>GitHub</a></li>
          {site.kofi && <li><a href={site.kofi}>Buy me a coffee on Ko-fi</a></li>}
          {site.charity.url && <li><a href={site.charity.url}>Donate to {site.charity.name}</a></li>}
        </ul>
      </div>
    </footer>
  </body>
</html>

<style>
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.5rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--step-1);
    font-weight: 450;
    letter-spacing: 0.01em;
    text-decoration: none;
  }
  nav { display: flex; gap: clamp(1rem, 3vw, 2rem); }
  nav a { color: var(--muted); text-decoration: none; }
  nav a:hover { color: var(--text); }

  .foot {
    border-top: 1px solid var(--line);
    padding-block: 2.5rem 3rem;
    color: var(--muted);
    font-size: var(--step--1);
  }
  .foot__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 2rem;
  }
  .foot ul { display: flex; gap: 1.5rem; margin: 0; padding: 0; list-style: none; }
</style>
